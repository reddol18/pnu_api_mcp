{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "verbatimModuleSyntax": false,
    "allowJs": false,
    "incremental": false,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app", "lib", "test", "next.config.ts"],
  "exclude": ["node_modules", ".next"]
}
