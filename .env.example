# 도로명주소 검색 API 승인키 (business.juso.go.kr)
JUSO_KEY=
# 공공데이터포털 일반 인증키 (data.go.kr) — 건축HUB 건축물대장정보 서비스
DATA_GO_KR_KEY=
# 브이월드 인증키 (vworld.kr) — 서비스 URL: https://pnu.reddol18.pe.kr
VWORLD_KEY=
# 브이월드 키 발급 때 등록한 서비스 URL. 서버 호출에 domain 파라미터로 꼭 보내야 한다(없으면 INCORRECT_KEY)
VWORLD_DOMAIN=https://pnu.reddol18.pe.kr
# 브이월드 배경지도(WMTS) 전용 키 — 브라우저에 그대로 노출된다(VWorld는 Referer를 검사하지 않음). 데이터 키와 따로 발급할 것
NEXT_PUBLIC_VWORLD_TILE_KEY=
